<Window x:Class="FrameForge.App.Dialogs.ImportConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm import"
        Height="480" Width="560"
        MinHeight="360" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        AutomationProperties.Name="Import confirmation dialog"
        KeyDown="Window_KeyDown">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"
               AutomationProperties.Name="Import dialog title" />
    <TextBlock DockPanel.Dock="Top" Text="{Binding SourcePath}" FontSize="11" TextWrapping="Wrap"
               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,12" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True"
              Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" MinWidth="100" Click="Cancel_Click"
              ToolTip="Close without importing (safest default)."
              AutomationProperties.Name="Cancel import"
              AutomationProperties.HelpText="Default action. Escape also cancels. No files are written." />
      <Button Content="Import as New" Style="{StaticResource NavButtonStyle}" Margin="0,0,8,0" Padding="12,8" MinWidth="110"
              Click="ImportAsNew_Click"
              IsEnabled="{Binding CanImportAsNew}"
              ToolTip="Import as new history entries. Fingerprints stay separate."
              AutomationProperties.Name="Import as new history" />
      <Button Content="Merge" Style="{StaticResource NavButtonStyle}" Padding="12,8" MinWidth="90"
              Click="Merge_Click"
              IsEnabled="{Binding CanMerge}"
              ToolTip="Merge into local intelligence. Fingerprints stay separate."
              AutomationProperties.Name="Merge import" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Conflicts" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding ConflictLines}" Margin="0,0,0,12"
                      AutomationProperties.Name="Import conflicts">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2"
                         Foreground="{StaticResource WarningBrush}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Fingerprints" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding FingerprintLines}" Margin="0,0,0,12"
                      AutomationProperties.Name="Import fingerprints">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Invalid records" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding InvalidLines}"
                      AutomationProperties.Name="Invalid import records">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2"
                         Foreground="{StaticResource DangerBrush}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="No files are written until you choose Import as New or Merge. Cancel is the default focus." />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
