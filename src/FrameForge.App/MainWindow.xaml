<Window x:Class="FrameForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrameForge — CS2 Performance Companion"
        Height="740" Width="1120"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}" Padding="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
          <TextBlock Text="FrameForge" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="Legitimate CS2 companion" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="{Binding StatusMessage}"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     TextWrapping="Wrap"
                     FontSize="12"
                     Margin="0,0,0,8" />
          <TextBlock Text="Working…"
                     Foreground="{StaticResource AccentBrush}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                     Margin="0,0,0,8" />
          <Button Content="Refresh"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding RefreshCommand}" />
        </StackPanel>

        <StackPanel>
          <Button Content="Home" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Home" />
          <Button Content="Optimize" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Optimize" />
          <Button Content="CS2 Settings" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Cs2" />
          <Button Content="Profiles" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Profiles" />
          <Button Content="Backups" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Backups" />
          <Button Content="Benchmark" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Benchmark" />
          <Button Content="Settings" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1" Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Error banner -->
      <Border Grid.Row="0"
              Background="#33EF4444"
              BorderBrush="{StaticResource DangerBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12"
              Margin="0,0,0,12"
              Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Content="Dismiss"
                  Command="{Binding ClearErrorCommand}"
                  Style="{StaticResource NavButtonStyle}"
                  Padding="8,4" />
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Grid Grid.Row="1">
        <!-- Home -->
        <ScrollViewer Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Home}">
          <StackPanel>
            <TextBlock Text="Dashboard" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16" />
            <UniformGrid Columns="2">
              <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12">
                <StackPanel>
                  <TextBlock Text="CS2 Status" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding Dashboard.Cs2.DetectionMessage}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Dashboard.Cs2.InstallPath}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Optimization Score" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding ScoreDisplay}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding ScoreSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12">
                <StackPanel>
                  <TextBlock Text="CPU" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding Dashboard.Hardware.CpuName}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                  <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{Binding Dashboard.Hardware.CpuCoreCount, Mode=OneWay}" />
                    <Run Text="cores /" />
                    <Run Text="{Binding Dashboard.Hardware.CpuThreadCount, Mode=OneWay}" />
                    <Run Text="threads" />
                  </TextBlock>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="GPU / RAM / OS" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding Dashboard.Hardware.GpuName}" Margin="0,6,0,0" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Dashboard.Hardware.FormattedRam}" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding Dashboard.Hardware.WindowsVersion}" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding Dashboard.Hardware.Architecture}" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Text="Status" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding Dashboard.OptimizationStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                  <Run Text="Recommendations:" />
                  <Run Text="{Binding Dashboard.AvailableRecommendationCount, Mode=OneWay}" />
                  <Run Text="· Applicable now:" />
                  <Run Text="{Binding Dashboard.ApplicableOptimizationCount, Mode=OneWay}" />
                  <Run Text="· Backups:" />
                  <Run Text="{Binding Dashboard.BackupCount, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,6,0,0">
                  <Run Text="Active profile:" />
                  <Run Text="{Binding Dashboard.ActiveProfileName, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Text="Score breakdown" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding ScoreFactors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="56" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold">
                          <Run Text="{Binding Points, Mode=OneWay}" />
                          <Run Text="pts" />
                        </TextBlock>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Reason}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="FrameForge never injects into CS2, edits memory, or bypasses anti-cheat."
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Optimize -->
        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Optimize}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Optimize" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock Grid.Row="1"
                     Text="No optimizations are registered."
                     Foreground="{StaticResource TextSecondaryBrush}"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     Visibility="{Binding ShowEmptyOptimizations, Converter={StaticResource BoolToVisibilityConverter}}" />
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Optimizations}"
                   Background="Transparent"
                   BorderThickness="0"
                   Visibility="{Binding ShowEmptyOptimizations, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardBorderStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,4,12,0"
                              IsEnabled="{Binding CanApply}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                      <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="{Binding Category, Mode=OneWay}" />
                        <Run Text="· Risk:" />
                        <Run Text="{Binding Risk, Mode=OneWay}" />
                        <Run Text="· Impact:" />
                        <Run Text="{Binding Impact, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding StatusText, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Apply Selected (with confirmation)"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ApplySelectedOptimizationsCommand}" />
            <TextBlock Text="Only applicable items can be selected. Advisory items explain why they cannot auto-apply."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <!-- CS2 Settings -->
        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Cs2}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,8">
            <TextBlock Text="CS2 Settings" FontSize="26" FontWeight="SemiBold" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Cs2SettingsStatus}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
          </DockPanel>
          <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Settings write to frameforge_settings.cfg in the real CS2 cfg folder. autoexec.cfg gets a marked FRAMEFORGE section that execs that file. User lines outside the markers are never removed."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Cs2AffectedFilesHint}"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" />
            <Border Background="#332F6FED" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="10" Margin="0,8,0,0"
                    Visibility="{Binding HasCs2ExecutionWarning, Converter={StaticResource BoolToVisibilityConverter}}">
              <TextBlock Text="{Binding Cs2ExecutionRecommendation}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding SettingCategories}"
                     SelectedItem="{Binding SelectedCategory}"
                     Background="Transparent" BorderThickness="0"
                     Margin="0,0,12,0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Margin="4,8" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Column="1">
              <TextBlock Text="No settings in this category (or CS2 not detected)."
                         Foreground="{StaticResource TextSecondaryBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding ShowEmptySettings, Converter={StaticResource BoolToVisibilityConverter}}" />
              <ListBox ItemsSource="{Binding SettingRows}"
                       SelectedItem="{Binding SelectedSetting}"
                       Background="Transparent" BorderThickness="0"
                       Visibility="{Binding ShowEmptySettings, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource CardBorderStyle}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="2*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                          <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0">
                            <Run Text="{Binding ConfigKey, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{Binding Source, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{Binding AllowedHint, Mode=OneWay}" />
                          </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0">
                          <TextBlock Text="Current" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                          <TextBlock Text="{Binding CurrentValue}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0">
                          <TextBlock Text="Recommended" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                          <TextBlock Text="{Binding RecommendedValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="8,0">
                          <TextBlock Text="Edit" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                          <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>

          <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0"
                  Visibility="{Binding HasPendingDiff, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Text="{Binding PendingDiffSummary}" FontWeight="SemiBold" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding DiffEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Margin="0,2" TextWrapping="Wrap">
                      <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                      <Run Text=":" />
                      <Run Text="{Binding CurrentValue, Mode=OneWay}" />
                      <Run Text="→" />
                      <Run Text="{Binding NewValue, Mode=OneWay}" />
                      <Run Text="(" />
                      <Run Text="{Binding Reason, Mode=OneWay}" />
                      <Run Text="· Risk" />
                      <Run Text="{Binding Risk, Mode=OneWay}" />
                      <Run Text=")" />
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <WrapPanel Grid.Row="4" Margin="0,12,0,0">
            <Button Content="Preview changes" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding PreviewSettingsApplyCommand}" Margin="0,0,8,8" />
            <Button Content="Apply (confirm + backup)" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplySettingsDiffCommand}" Margin="0,0,8,8" />
            <Button Content="Clear diff" Style="{StaticResource NavButtonStyle}" Command="{Binding ClearSettingsDiffCommand}" Margin="0,0,8,8" />
            <Button Content="Save as Profile" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveAsProfileCommand}" Margin="0,0,8,8" />
            <Button Content="Compare with Profile" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CompareWithProfileCommand}" Margin="0,0,8,8" />
            <Button Content="Reset FrameForge changes" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ResetFrameForgeSettingsCommand}" Margin="0,0,8,8" />
          </WrapPanel>
        </Grid>

        <!-- Profiles -->
        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Profiles}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Profiles" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock Grid.Row="0" Text="Built-in profiles are protected. Apply always shows a diff and requires confirmation."
                     Foreground="{StaticResource TextSecondaryBrush}" Margin="120,8,0,12" HorizontalAlignment="Right" />
          <TextBlock Grid.Row="1"
                     Text="No profiles loaded."
                     Foreground="{StaticResource TextSecondaryBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding ShowEmptyProfiles, Converter={StaticResource BoolToVisibilityConverter}}" />
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Profiles}"
                   SelectedItem="{Binding SelectedProfile}"
                   Background="Transparent" BorderThickness="0"
                   Visibility="{Binding ShowEmptyProfiles, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardBorderStyle}">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                      <TextBlock DockPanel.Dock="Right"
                                 Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="{Binding SettingCount, Mode=OneWay}" />
                        <Run Text="settings" />
                      </TextBlock>
                    </DockPanel>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                      <Run Text="Updated" />
                      <Run Text="{Binding UpdatedAt, Mode=OneWay}" />
                      <Run Text="·" />
                      <Run Text="{Binding IsBuiltIn, Mode=OneWay, StringFormat=Built-in: {0}}" />
                      <Run Text="· schema" />
                      <Run Text="{Binding SchemaVersion, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Select / Activate" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ActivateProfileCommand}" Margin="0,0,8,8" />
            <Button Content="Preview diff" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding PreviewProfileCommand}" Margin="0,0,8,8" />
            <Button Content="Apply (diff + confirm)" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplyProfileCommand}" Margin="0,0,8,8" />
            <Button Content="Duplicate" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DuplicateProfileCommand}" Margin="0,0,8,8" />
            <Button Content="Export" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExportProfileCommand}" Margin="0,0,8,8" />
            <Button Content="Import" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ImportProfileCommand}" Margin="0,0,8,8" />
            <Button Content="Create" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateProfileCommand}" Margin="0,0,8,8" />
            <Button Content="Rename" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RenameProfileCommand}" Margin="0,0,8,8" />
            <Button Content="Delete" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DeleteProfileCommand}" Margin="0,0,8,8" />
          </WrapPanel>
        </Grid>

        <!-- Backups -->
        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Backups}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Backups" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock Grid.Row="1"
                     Text="No backups yet. Apply an optimization with automatic backup enabled to create one."
                     Foreground="{StaticResource TextSecondaryBrush}"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding ShowEmptyBackups, Converter={StaticResource BoolToVisibilityConverter}}" />
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Backups}"
                   SelectedItem="{Binding SelectedBackup}"
                   Background="Transparent" BorderThickness="0"
                   Visibility="{Binding ShowEmptyBackups, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardBorderStyle}">
                  <StackPanel>
                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Grid.Row="2" Content="Restore Selected Backup (with confirmation)"
                  Style="{StaticResource PrimaryButtonStyle}"
                  HorizontalAlignment="Left"
                  Command="{Binding RestoreBackupCommand}"
                  Margin="0,12,0,0" />
        </Grid>

        <!-- Benchmark -->
        <ScrollViewer Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Benchmark}">
          <StackPanel>
            <TextBlock Text="Benchmark" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"
                       Text="External OS counters only. FrameForge does not inject into CS2, hook DirectX, or invent FPS. Frame-time stays unavailable unless a future external source provides it. Results are stored locally under Benchmarks/." />

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">Session</TextBlock>
                <TextBlock Margin="0,0,0,4">
                  <Run Text="Status:" />
                  <Run Text="{Binding BenchmarkStatusText, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock Text="{Binding BenchmarkLiveStatus}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Margin="0,0,0,4">
                  <Run Text="Active profile:" />
                  <Run Text="{Binding SelectedProfile.Name, Mode=OneWay, FallbackValue=—}" />
                </TextBlock>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Duration (s)" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding BenchmarkDurationOptions}" SelectedItem="{Binding BenchmarkDurationSeconds}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Sample interval (ms)" Margin="0,0,0,4" />
                    <TextBox Text="{Binding BenchmarkSampleIntervalMs, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Warm-up (s)" Margin="0,0,0,4" />
                    <TextBox Text="{Binding BenchmarkWarmupSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
                  </StackPanel>
                </Grid>
                <WrapPanel Margin="0,12,0,0">
                  <Button Content="Start Benchmark" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartBenchmarkCommand}" Margin="0,0,8,8" />
                  <Button Content="Stop" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StopBenchmarkCommand}" Margin="0,0,8,8" />
                  <Button Content="Cancel" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CancelBenchmarkCommand}" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">Last result</TextBlock>
                <TextBlock Text="{Binding LastBenchmarkSummary}" TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Text="P1 / P0.1 are frame-time percentiles (99th / 99.9th) when frame-time exists — not FPS percentiles." />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12"
                    Visibility="{Binding HasBenchmarkChart, Converter={StaticResource BoolToVisibilityConverter}}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">Live sample timeline (system/process CPU %)</TextBlock>
                <ItemsControl ItemsSource="{Binding BenchmarkChartPoints}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Width="6" Height="{Binding Value}" MinHeight="2" MaxHeight="80"
                              Background="{StaticResource AccentBrush}" Margin="1,0" VerticalAlignment="Bottom"
                              ToolTip="{Binding Label}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0"
                           Text="Bars are measured samples only (warm-up excluded from chart). Height maps to percent." />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
              <StackPanel>
                <DockPanel Margin="0,0,0,8">
                  <TextBlock Text="History (local JSON)" FontWeight="SemiBold" />
                  <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshBenchmarkHistoryCommand}" Style="{StaticResource NavButtonStyle}" Padding="8,4" />
                </DockPanel>
                <TextBlock Text="No saved benchmarks yet."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding ShowEmptyBenchmarks, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ListBox ItemsSource="{Binding BenchmarkHistory}"
                         SelectedItem="{Binding SelectedBenchmarkA}"
                         Background="Transparent" BorderThickness="0"
                         Visibility="{Binding ShowEmptyBenchmarks, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                         MaxHeight="220">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,6" Padding="10">
                        <StackPanel>
                          <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" />
                          <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                            <Run Text="{Binding Status, Mode=OneWay}" />
                            <Run Text="· CPU" />
                            <Run Text="{Binding Result.SystemCpu.Average, Mode=OneWay, StringFormat={}{0:0.0}}" />
                            <Run Text="% · samples" />
                            <Run Text="{Binding Result.MeasuredSampleCount, Mode=OneWay}" />
                          </TextBlock>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Compare A (selected above) with B:" Margin="0,8,0,4" />
                <ComboBox ItemsSource="{Binding BenchmarkHistory}" SelectedItem="{Binding SelectedBenchmarkB}" DisplayMemberPath="DisplayTitle" Margin="0,0,0,8" />
                <WrapPanel>
                  <Button Content="Compare A vs B" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CompareBenchmarksCommand}" Margin="0,0,8,8" />
                  <Button Content="Export JSON" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExportBenchmarkJsonCommand}" Margin="0,0,8,8" />
                  <Button Content="Export CSV" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExportBenchmarkCsvCommand}" Margin="0,0,8,8" />
                  <Button Content="Delete A" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DeleteBenchmarkCommand}" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}"
                    Visibility="{Binding HasBenchmarkComparison, Converter={StaticResource BoolToVisibilityConverter}}">
              <StackPanel>
                <TextBlock Text="{Binding BenchmarkComparisonSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding BenchmarkComparisonRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="2*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Metric}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding Before, StringFormat={}{0:0.##}}" />
                        <TextBlock Grid.Column="2" Text="{Binding After, StringFormat={}{0:0.##}}" />
                        <TextBlock Grid.Column="3">
                          <Run Text="{Binding Difference, Mode=OneWay, StringFormat={}{0:+0.##;-0.##;0}}" />
                          <Run Text="{Binding Unit, Mode=OneWay}" />
                        </TextBlock>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Settings -->
        <ScrollViewer Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Settings}">
          <StackPanel>
            <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16" />
            <Border Style="{StaticResource CardBorderStyle}">
              <StackPanel>
                <CheckBox Content="Automatic backup before applying optimizations"
                          IsChecked="{Binding Settings.AutomaticBackup}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,12" />
                <CheckBox Content="Launch at Windows startup (registration not implemented yet)"
                          IsChecked="{Binding Settings.LaunchAtStartup}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,12" />
                <TextBlock Text="Logging level" Margin="0,0,0,4" />
                <ComboBox SelectedItem="{Binding Settings.LoggingLevel}"
                          ItemsSource="{Binding LoggingLevels}"
                          Margin="0,0,0,12" />
                <TextBlock Text="Theme" Margin="0,0,0,4" />
                <ComboBox SelectedItem="{Binding Settings.Theme}"
                          ItemsSource="{Binding Themes}"
                          Margin="0,0,0,12" />
                <TextBlock Text="Custom Steam path (optional)" Margin="0,0,0,4" />
                <TextBox Text="{Binding Settings.CustomSteamPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="8" />
                <TextBlock Text="Custom CS2 path (optional)" Margin="0,0,0,4" />
                <TextBox Text="{Binding Settings.CustomCs2Path, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" Padding="8" />
                <StackPanel Orientation="Horizontal">
                  <Button Content="Save Settings" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveSettingsCommand}" Margin="0,0,8,0" />
                  <Button Content="Reset Settings" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ResetSettingsCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
